# mail-printer environment variables.
# Copy to `.env` on each machine (gitignored) and fill in the relevant section.
# Locally: `uv run --env-file .env mail-printer-server` / `mail-printer-print-agent`.

# ── Both machines ─────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Long random shared secret authenticating print-agent on /ws/printer.
# Namespaced per app (`PRINTER_TOKEN_<APP>`) because one print-agent serves
# several Hetzner apps -- see docs/decisions/0001-shared-print-agent.md.
# Must be identical on the VPS and the Pi. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRINTER_TOKEN_MAILPRINTER=

# ── Server (Hetzner VPS) ──────────────────────────────────────────────────
# uvicorn bind address (Caddy reverse-proxies to it)
HOST=127.0.0.1
PORT=8000
# Runtime data: SQLite DB, photos/, tickets/
DATA_DIR=data
# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin console: password hash + key signing the session cookie
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Seconds to wait for print-agent's ack before marking a job failed
PRINTER_ACK_TIMEOUT=60

# ── print-agent (Raspberry Pi) ────────────────────────────────────────────
# One SERVER_WS_URL_<APP> / PRINTER_TOKEN_<APP> pair per app print-agent
# serves; apps are discovered by scanning SERVER_WS_URL_*.
SERVER_WS_URL_MAILPRINTER=wss://example.com/ws/printer
# Printer USB ids (hex) and python-escpos profile
PRINTER_USB_VENDOR_ID=0x0483
PRINTER_USB_PRODUCT_ID=0x5743
PRINTER_PROFILE=TM-T20II
# Reconnect backoff bounds (seconds)
RECONNECT_MIN_SECONDS=1.0
RECONNECT_MAX_SECONDS=60.0
