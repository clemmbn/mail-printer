# mail-printer environment variables.
# Copy to `.env` on each machine (gitignored) and fill in the relevant section.
# Locally: `uv run --env-file .env mail-printer-server` / `mail-printer-print-agent`.

# ── Both machines ─────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Long random shared secret authenticating print-agent on /ws/printer.
# Must be identical on the VPS and the Pi. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NOTE: CLE-136/CLE-138 will namespace this per app (e.g. one token per
# Hetzner app print-agent talks to) per docs/decisions/0001-shared-print-agent.md.
PRINTER_TOKEN=

# ── Server (Hetzner VPS) ──────────────────────────────────────────────────
# uvicorn bind address (Caddy reverse-proxies to it)
HOST=127.0.0.1
PORT=8000
# Runtime data: SQLite DB, photos/, tickets/
DATA_DIR=data
# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin console: password hash + key signing the session cookie
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── print-agent (Raspberry Pi) ────────────────────────────────────────────
SERVER_WS_URL=wss://example.com/ws/printer
# Printer USB ids (hex) and python-escpos profile
PRINTER_USB_VENDOR_ID=0x0483
PRINTER_USB_PRODUCT_ID=0x5743
PRINTER_PROFILE=TM-T20II
